[Unit]
Description=VolleyballPi fallback Wi-Fi provisioning
Wants=NetworkManager.service
After=NetworkManager.service
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/volleyball-schedule-monitor
EnvironmentFile=/etc/volleyball-wifi-provision.env
ExecStart=/opt/volleyball-schedule-monitor/.venv/bin/python -m src.wifi_provision
Restart=on-failure
RestartSec=20s
TimeoutStartSec=infinity
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/NetworkManager/system-connections /run /var/lib/NetworkManager

[Install]
WantedBy=multi-user.target
