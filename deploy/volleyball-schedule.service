[Unit]
Description=Volleyball schedule monitor
Wants=NetworkManager.service
After=NetworkManager.service
[Service]
Type=oneshot
User=volleyball
Group=volleyball
RuntimeDirectory=volleyball-schedule-monitor
RuntimeDirectoryMode=0755
WorkingDirectory=/opt/volleyball-schedule-monitor
EnvironmentFile=/etc/volleyball-schedule-monitor.env
ExecStart=/usr/bin/flock -n /run/volleyball-schedule-monitor/monitor.lock /opt/volleyball-schedule-monitor/.venv/bin/python /opt/volleyball-schedule-monitor/main.py
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
