# Protected configuration. Copy to /etc/volleyball-schedule-monitor.env on a Pi,
# or to .env for local development. Do not commit the copy containing real values.
PAGE_URL=https://kvapack.ca/adult-indoor/
KEYWORD=Volleyball

ICLOUD_USERNAME=your-email@example.com
ICLOUD_PASSWORD=your-icloud-app-password
CALENDAR_INDEX=1
# CALENDAR_NAME=Example Volleyball Calendar

GMAIL_USERNAME=your-email@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Comma-separated recipient list. Public team/gym settings belong in settings.json.
EMAIL_RECIPIENTS=player@example.com

RUNTIME_DIR=/var/lib/volleyball-schedule-monitor
HTTP_TIMEOUT_SECONDS=20
SMTP_TIMEOUT_SECONDS=30
CALDAV_TIMEOUT_SECONDS=45
PDF_MAX_BYTES=8388608
UI_HOST=0.0.0.0
UI_PORT=8080
